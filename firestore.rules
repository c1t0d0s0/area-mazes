rules_version = '2';

// Records are stored per user under users/{uid}.
//   users/{uid}                                User document (shared by all apps)
//   users/{uid}/apps/{appId}                   Per-app summary
//   users/{uid}/apps/{appId}/progress/{itemId} Progress on one item
// Only the signed-in owner can read and write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
